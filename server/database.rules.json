{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null && !root.child('blockedUsers').child(auth.uid).exists()",
        ".write": "auth != null && !root.child('blockedUsers').child(auth.uid).exists()",
        "players": {
          "$uid": {
            ".validate": "!root.child('blockedUsers').child($uid).exists() || newData.child('forfeited').val() === true"
          }
        }
      }
    },
    "roomChats": {
      "$room": {
        ".read": "auth != null && !root.child('blockedUsers').child(auth.uid).exists() && root.child('rooms').child($room).child('players').child(auth.uid).exists()",
        ".write": false,
        ".indexOn": [
          "createdAt"
        ]
      }
    },
    "blockedUsers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "chatArchiveQueue": {
      "$room": {
        ".read": "auth != null && !root.child('blockedUsers').child(auth.uid).exists() && root.child('rooms').child($room).child('players').child(auth.uid).exists()",
        ".indexOn": [
          "createdAt"
        ],
        "$message": {
          ".write": "auth != null && !root.child('blockedUsers').child(auth.uid).exists() && root.child('rooms').child($room).child('players').child(auth.uid).exists() && root.child('chatConfig/asyncEnabled').val() === true && !data.exists() && newData.exists() && !root.child('chatArchiveReceipts').child($room).child($message).exists() && !root.child('roomChats').child($room).child($message).exists() && $room.matches(/^[0-9]{6}$/) && $message.matches(/^c_[a-f0-9]{32}$/) && (root.child('rooms').child($room).child('status').val() === 'waiting' || root.child('rooms').child($room).child('status').val() === 'results')",
          ".validate": "newData.hasChildren(['uid','name','playerId','text','session','createdAt']) && newData.parent().parent().parent().child('chatSendTimes').child(auth.uid).val() === now",
          "uid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16 && newData.val() === root.child('rooms').child($room).child('players').child(auth.uid).child('name').val()"
          },
          "playerId": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-zA-Z0-9_-]{20,80}$/) && newData.val() === root.child('rooms').child($room).child('players').child(auth.uid).child('playerId').val()"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
          },
          "session": {
            ".validate": "newData.isString() && newData.val() === root.child('rooms').child($room).child('createdAt').val() + ''"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "chatSendTimes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !root.child('blockedUsers').child(auth.uid).exists() && root.child('chatConfig/asyncEnabled').val() === true && newData.isNumber() && newData.val() === now"
      }
    },
    "chatArchiveReceipts": {
      ".read": false,
      ".write": false
    },
    "chatConfig": {
      "asyncEnabled": {
        ".read": "auth != null",
        ".write": false
      }
    }
  }
}
